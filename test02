<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="description" content="사각형을 누르면 가운데와 오른쪽 사이를 부드럽게 이동하는 프로토타입">
    <title>사각형 이동 프로토타입</title>
    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: #fff; }
      body { min-height: 100svh; display: grid; place-items: center; }
      .canvas { position: relative; width: min(100vw, 177.777778svh); aspect-ratio: 16 / 9; }
      .square {
        position: absolute;
        left: 38.4895833%;
        top: 29.537037%;
        width: 23.0208333%;
        aspect-ratio: 1;
        padding: 0;
        border: 0;
        border-radius: 0;
        appearance: none;
        background: #d9d9d9;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
      }
      .square[aria-pressed="true"] { transform: translateX(104.7511312%); }
      .square:focus-visible { outline: 3px solid #0a73dc; outline-offset: 6px; }
      @media (prefers-reduced-motion: reduce) {
        .square { transition: none; }
      }
    </style>
  </head>
  <body>
    <main class="canvas" aria-label="공유된 디자인 미리보기">
      <button class="square" type="button" aria-label="사각형을 오른쪽으로 이동" aria-pressed="false"></button>
    </main>
    <script>
      const square = document.querySelector('.square');
      square.addEventListener('click', () => {
        const moveRight = square.getAttribute('aria-pressed') !== 'true';
        square.setAttribute('aria-pressed', String(moveRight));
        square.setAttribute('aria-label', moveRight ? '사각형을 가운데로 이동' : '사각형을 오른쪽으로 이동');
      });
    </script>
  </body>
</html>
